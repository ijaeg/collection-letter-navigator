# Copy to .env and fill in. .env is gitignored and never committed (FR-23 AC3).

# The only key the app needs (NFR-01).
OPENROUTER_API_KEY=

# Chat model (D-2, FR-20 AC2).
CHAT_MODEL=openai/gpt-5-mini

# Embedding model (D-1, FR-04 AC6).
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Optional settings; the values shown are the defaults.
# Further models for the developer settings, comma-separated (FR-20, D-14).
# CHAT_MODEL_OPTIONS=anthropic/claude-haiku-4.5
# Reasoning effort of the answer call and of the retrieval plan (D-2, D-9).
# REASONING_EFFORT=low
# PLAN_REASONING_EFFORT=low
# Retrieval: vector, bm25 or hybrid; query translation on or off (D-10, FR-05 AC4).
# RETRIEVAL_MODE=vector
# QUERY_TRANSLATION=on
# Move provisions named in the search plan to the top (D-8).
# PIN_EXPLICIT_REFERENCES=on
# Write every LLM call to logs/llm_calls.jsonl, for development only (FR-23 AC2).
# DEBUG_LOG=0
